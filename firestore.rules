rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Salons : lus par l'app, écrits uniquement par les scripts d'admin
    // (l'Admin SDK contourne ces règles).
    match /salons/{salonId} {
      allow read: if true;
      allow write: if false;
    }

    // Users collection - temporairement ouvert pour le seed
    match /users/{userId} {
      allow read, write: if true;
    }

    // Habits collection - ouvert en lecture/écriture
    // La sécurité est gérée côté client via le token
    match /habits/{habitDocId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Congratulations collection - ouvert (sécurité via token côté client)
    match /congratulations/{congratsId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }
  }
}
